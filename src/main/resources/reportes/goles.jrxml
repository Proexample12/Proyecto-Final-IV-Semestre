<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="goles"
              pageWidth="842" pageHeight="595"
              orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20">

  <style name="titulo" fontName="SansSerif" fontSize="16" isBold="true"
         forecolor="#FFFFFF" mode="Opaque" hTextAlign="Left" vTextAlign="Middle"/>

  <style name="encabezado" fontName="SansSerif" fontSize="9" isBold="true"
         forecolor="#FFFFFF" backcolor="#0F2A24"
         mode="Opaque" hTextAlign="Center" vTextAlign="Middle">
    <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
  </style>

  <style name="filaNormal" fontName="SansSerif" fontSize="8"
         forecolor="#14221E" hTextAlign="Center" vTextAlign="Middle" mode="Opaque">
    <box><pen lineWidth="0.3" lineColor="#DCE5E0"/></box>
    <conditionalStyle>
      <conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
      <style backcolor="#F2F5F3" mode="Opaque"/>
    </conditionalStyle>
  </style>

  <style name="filaLeft" style="filaNormal" hTextAlign="Left">
    <box leftPadding="5"/>
  </style>

  <style name="footer" fontName="SansSerif" fontSize="8" forecolor="#4A5B55" vTextAlign="Middle"/>

  <parameter name="LIGA_NOMBRE"    class="java.lang.String"/>
  <parameter name="FECHA_EMISION"  class="java.lang.String"/>
  <parameter name="TOTAL_GOLES"    class="java.lang.String"/>
  <parameter name="PROMEDIO"       class="java.lang.String"/>
  <parameter name="OVER_25"        class="java.lang.String"/>
  <parameter name="MAX_GOLES"      class="java.lang.String"/>

  <field name="jornada"    class="java.lang.Integer"/>
  <field name="local"      class="java.lang.String"/>
  <field name="marcador"   class="java.lang.String"/>
  <field name="visitante"  class="java.lang.String"/>
  <field name="totalGoles" class="java.lang.Integer"/>
  <field name="resultado"  class="java.lang.String"/>

  <title>
    <band height="65">
      <rectangle>
        <reportElement x="0" y="0" width="802" height="42" backcolor="#17775A" mode="Opaque">
          <property name="com.jaspersoft.studio.unit.height" value="px"/>
        </reportElement>
        <graphicElement><pen lineWidth="0.0"/></graphicElement>
      </rectangle>
      <textField>
        <reportElement style="titulo" x="12" y="0" width="580" height="42" forecolor="#FFFFFF" backcolor="#17775A"/>
        <textFieldExpression><![CDATA["Reporte de Partidos y Goles - " + $P{LIGA_NOMBRE}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="600" y="11" width="190" height="20" forecolor="#E0F2E9"/>
        <box leftPadding="5"/>
        <textElement textAlignment="Right" verticalAlignment="Middle">
          <font fontName="SansSerif" size="9"/>
        </textElement>
        <textFieldExpression><![CDATA["Fecha de emisión: " + $P{FECHA_EMISION}]]></textFieldExpression>
      </textField>

      <!-- Barra de KPIs debajo del título -->
      <rectangle>
        <reportElement x="0" y="44" width="802" height="19" backcolor="#F2F5F3" mode="Opaque">
          <property name="com.jaspersoft.studio.unit.height" value="px"/>
        </reportElement>
        <graphicElement><pen lineWidth="0.5" lineColor="#DCE5E0"/></graphicElement>
      </rectangle>
      <textField isBlankWhenNull="true">
        <reportElement x="8" y="44" width="190" height="19"/>
        <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
        <textFieldExpression><![CDATA[$P{TOTAL_GOLES}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement x="205" y="44" width="195" height="19"/>
        <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
        <textFieldExpression><![CDATA[$P{PROMEDIO}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement x="405" y="44" width="195" height="19"/>
        <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
        <textFieldExpression><![CDATA[$P{OVER_25}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement x="605" y="44" width="190" height="19"/>
        <textElement verticalAlignment="Middle"><font fontName="SansSerif" size="8"/></textElement>
        <textFieldExpression><![CDATA[$P{MAX_GOLES}]]></textFieldExpression>
      </textField>
    </band>
  </title>

  <columnHeader>
    <band height="22">
      <staticText>
        <reportElement style="encabezado" x="0" y="0" width="60" height="22"/>
        <text><![CDATA[Jornada]]></text>
      </staticText>
      <staticText>
        <reportElement style="encabezado" x="60" y="0" width="220" height="22"/>
        <textElement textAlignment="Left"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
        <text><![CDATA[Equipo Local]]></text>
      </staticText>
      <staticText>
        <reportElement style="encabezado" x="280" y="0" width="80" height="22"/>
        <text><![CDATA[Marcador]]></text>
      </staticText>
      <staticText>
        <reportElement style="encabezado" x="360" y="0" width="220" height="22"/>
        <box leftPadding="5"/>
        <textElement textAlignment="Left"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
        <text><![CDATA[Equipo Visitante]]></text>
      </staticText>
      <staticText>
        <reportElement style="encabezado" x="580" y="0" width="80" height="22"/>
        <text><![CDATA[Total Goles]]></text>
      </staticText>
      <staticText>
        <reportElement style="encabezado" x="660" y="0" width="142" height="22"/>
        <text><![CDATA[Resultado]]></text>
      </staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="18">
      <textField isBlankWhenNull="true">
        <reportElement style="filaNormal" x="0" y="0" width="60" height="18"/>
        <textFieldExpression><![CDATA[$F{jornada} == null ? "—" : $F{jornada}.toString()]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="filaLeft" x="60" y="0" width="220" height="18"/>
        <textFieldExpression><![CDATA[$F{local}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="filaNormal" x="280" y="0" width="80" height="18"/>
        <textElement><font fontName="SansSerif" size="8" isBold="true"/></textElement>
        <textFieldExpression><![CDATA[$F{marcador}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="filaLeft" x="360" y="0" width="220" height="18"/>
        <textFieldExpression><![CDATA[$F{visitante}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="filaNormal" x="580" y="0" width="80" height="18"/>
        <textFieldExpression><![CDATA[$F{totalGoles}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="filaNormal" x="660" y="0" width="142" height="18"/>
        <textFieldExpression><![CDATA[$F{resultado}]]></textFieldExpression>
      </textField>
    </band>
  </detail>

  <pageFooter>
    <band height="24">
      <line><reportElement x="0" y="2" width="802" height="1" forecolor="#DCE5E0"/></line>
      <staticText>
        <reportElement style="footer" x="0" y="5" width="400" height="18"/>
        <text><![CDATA[Generado por: Sistema de Futbol]]></text>
      </staticText>
      <textField>
        <reportElement style="footer" x="650" y="5" width="152" height="18"/>
        <textElement textAlignment="Right"/>
        <textFieldExpression><![CDATA["Pág. " + $V{PAGE_NUMBER}]]></textFieldExpression>
      </textField>
    </band>
  </pageFooter>

</jasperReport>
