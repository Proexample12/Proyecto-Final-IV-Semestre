<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
                http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="rendimiento"
              pageWidth="842" pageHeight="595"
              orientation="Landscape"
              columnWidth="802" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20">

  <parameter name="LIGA_NOMBRE"   class="java.lang.String"/>
  <parameter name="FECHA_EMISION" class="java.lang.String"/>

  <field name="pos"          class="java.lang.Integer"/>
  <field name="equipo"       class="java.lang.String"/>
  <field name="pj"           class="java.lang.Integer"/>
  <field name="pts"          class="java.lang.Integer"/>
  <field name="efectividad"  class="java.lang.String"/>
  <field name="golesPartido" class="java.lang.String"/>
  <field name="solidez"      class="java.lang.String"/>
  <field name="zona"         class="java.lang.String"/>

  <style name="titulo" fontName="SansSerif" fontSize="16" isBold="true"
         forecolor="#FFFFFF" mode="Opaque" hTextAlign="Left" vTextAlign="Middle"/>

  <style name="encabezado" fontName="SansSerif" fontSize="9" isBold="true"
         forecolor="#FFFFFF" backcolor="#0F2A24"
         mode="Opaque" hTextAlign="Center" vTextAlign="Middle">
    <box><pen lineWidth="0.5" lineColor="#FFFFFF"/></box>
  </style>

  <style name="filaNormal" fontName="SansSerif" fontSize="8"
         forecolor="#14221E" hTextAlign="Center" vTextAlign="Middle" mode="Opaque">
    <box><pen lineWidth="0.3" lineColor="#DCE5E0"/></box>
    <conditionalStyle>
      <conditionExpression><![CDATA[$V{REPORT_COUNT} % 2 == 0]]></conditionExpression>
      <style backcolor="#F2F5F3" mode="Opaque"/>
    </conditionalStyle>
    <conditionalStyle>
      <conditionExpression><![CDATA[$F{zona} != null && $F{zona}.contains("Champions")]]></conditionExpression>
      <style backcolor="#D6EDFF" mode="Opaque"/>
    </conditionalStyle>
    <conditionalStyle>
      <conditionExpression><![CDATA[$F{zona} != null && $F{zona}.contains("Europa")]]></conditionExpression>
      <style backcolor="#FFF3CD" mode="Opaque"/>
    </conditionalStyle>
    <conditionalStyle>
      <conditionExpression><![CDATA[$F{zona} != null && $F{zona}.contains("Descenso")]]></conditionExpression>
      <style backcolor="#FFDAD6" mode="Opaque"/>
    </conditionalStyle>
  </style>

  <style name="filaLeft" style="filaNormal" hTextAlign="Left">
    <box leftPadding="5"/>
  </style>

  <style name="footer" fontName="SansSerif" fontSize="8" forecolor="#4A5B55" vTextAlign="Middle"/>

  <title>
    <band height="44">
      <rectangle>
        <reportElement x="0" y="0" width="802" height="44" backcolor="#17775A" mode="Opaque">
          <property name="com.jaspersoft.studio.unit.height" value="px"/>
        </reportElement>
        <graphicElement><pen lineWidth="0.0"/></graphicElement>
      </rectangle>
      <textField>
        <reportElement style="titulo" x="12" y="0" width="580" height="44" forecolor="#FFFFFF" backcolor="#17775A"/>
        <textFieldExpression><![CDATA["Reporte de Rendimiento - " + $P{LIGA_NOMBRE}]]></textFieldExpression>
      </textField>
      <textField>
        <reportElement x="600" y="12" width="190" height="20" forecolor="#E0F2E9"/>
        <textElement textAlignment="Right" verticalAlignment="Middle">
          <font fontName="SansSerif" size="9"/>
        </textElement>
        <textFieldExpression><![CDATA["Fecha de emisión: " + $P{FECHA_EMISION}]]></textFieldExpression>
      </textField>
    </band>
  </title>

  <columnHeader>
    <band height="22">
      <staticText>
        <reportElement style="encabezado" x="0" y="0" width="40" height="22"/>
        <text><![CDATA[Pos.]]></text>
      </staticText>
      <staticText>
        <reportElement style="encabezado" x="40" y="0" width="200" height="22"/>
        <textElement textAlignment="Left"><font fontName="SansSerif" size="9" isBold="true"/></textElement>
        <box leftPadding="5"/>
        <text><![CDATA[Equipo]]></text>
      </staticText>
      <staticText>
        <reportElement style="encabezado" x="240" y="0" width="50" height="22"/>
        <text><![CDATA[PJ]]></text>
      </staticText>
      <staticText>
        <reportElement style="encabezado" x="290" y="0" width="55" height="22"/>
        <text><![CDATA[Pts]]></text>
      </staticText>
      <staticText>
        <reportElement style="encabezado" x="345" y="0" width="105" height="22"/>
        <text><![CDATA[Efectividad]]></text>
      </staticText>
      <staticText>
        <reportElement style="encabezado" x="450" y="0" width="105" height="22"/>
        <text><![CDATA[Goles / Partido]]></text>
      </staticText>
      <staticText>
        <reportElement style="encabezado" x="555" y="0" width="105" height="22"/>
        <text><![CDATA[Solidez Defensiva]]></text>
      </staticText>
      <staticText>
        <reportElement style="encabezado" x="660" y="0" width="142" height="22"/>
        <text><![CDATA[Zona]]></text>
      </staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="18">
      <textField isBlankWhenNull="true">
        <reportElement style="filaNormal" x="0" y="0" width="40" height="18"/>
        <textFieldExpression><![CDATA[$F{pos}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="filaLeft" x="40" y="0" width="200" height="18"/>
        <textFieldExpression><![CDATA[$F{equipo}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="filaNormal" x="240" y="0" width="50" height="18"/>
        <textFieldExpression><![CDATA[$F{pj}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="filaNormal" x="290" y="0" width="55" height="18"/>
        <textElement><font fontName="SansSerif" size="8" isBold="true"/></textElement>
        <textFieldExpression><![CDATA[$F{pts}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="filaNormal" x="345" y="0" width="105" height="18"/>
        <textFieldExpression><![CDATA[$F{efectividad}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="filaNormal" x="450" y="0" width="105" height="18"/>
        <textFieldExpression><![CDATA[$F{golesPartido}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="filaNormal" x="555" y="0" width="105" height="18"/>
        <textFieldExpression><![CDATA[$F{solidez}]]></textFieldExpression>
      </textField>
      <textField isBlankWhenNull="true">
        <reportElement style="filaNormal" x="660" y="0" width="142" height="18"/>
        <textFieldExpression><![CDATA[$F{zona}]]></textFieldExpression>
      </textField>
    </band>
  </detail>

  <pageFooter>
    <band height="24">
      <line><reportElement x="0" y="2" width="802" height="1" forecolor="#DCE5E0"/></line>
      <staticText>
        <reportElement style="footer" x="0" y="5" width="400" height="18"/>
        <text><![CDATA[Generado por: Sistema de Futbol]]></text>
      </staticText>
      <textField>
        <reportElement style="footer" x="650" y="5" width="152" height="18"/>
        <textElement textAlignment="Right"/>
        <textFieldExpression><![CDATA["Pág. " + $V{PAGE_NUMBER}]]></textFieldExpression>
      </textField>
    </band>
  </pageFooter>

</jasperReport>
